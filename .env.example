# Copy to backend/.env. Never commit the real file.
ANTHROPIC_API_KEY=
# Comma-separated Fernet keys; the first encrypts, all decrypt. Generate one with:
#   uv --project backend run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEYS=
# JSON object: user name -> argon2id hash. Generate a hash with:
#   uv --project backend run python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('change-me'))"
REVIEWER_ACCOUNTS={}
DAILY_TOKEN_BUDGET=2000000
RETENTION_DAYS=30
APPLICANT_NAME_THRESHOLD=0.85
DATA_DIR=var
COOKIE_SECURE=true
# HMAC key for session cookies: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
TESSDATA_PREFIX=../var/tessdata
